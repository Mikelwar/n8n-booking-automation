# Reference settings for running a dedicated n8n instance for this project.
# API keys are NOT configured here: create them as n8n credentials (Header Auth / Google OAuth2) in the n8n UI.

# n8n container
N8N_PORT=6083
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:6083/
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# Image used by scripts/e2e/run-e2e.sh (throwaway container, --network none)
N8N_IMAGE=n8n-ffmpeg:2.37.10
